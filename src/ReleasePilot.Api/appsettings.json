{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "PromotionExchange": "releasepilot.promotions",
    "PromotionRoutingKeyPrefix": "promotion"
  },
  "PromotionRepository": {
    "ConnectionString": "Host=localhost;Port=5432;Database=releasepilot;Username=releasepilot;Password=releasepilot"
  },
  "OutboxPublisher": {
    "PollIntervalSeconds": 3,
    "BatchSize": 50,
    "RetryDelaySeconds": 10,
    "MaxRetryCount": 10
  },
  "RateLimiting": {
    "Read": {
      "TokenLimit": 60,
      "TokensPerPeriod": 60,
      "ReplenishmentPeriodSeconds": 60,
      "QueueLimit": 20
    },
    "Write": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Transition": {
      "PermitLimit": 5,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "ExternalPorts": {
    "Mode": "Stub",
    "Deployment": {
      "BaseUrl": "https://deployment.example.internal",
      "TimeoutSeconds": 5,
      "Resilience": {
        "RetryMaxAttempts": 2,
        "CircuitBreakerMinimumThroughput": 5,
        "CircuitBreakerSamplingSeconds": 30,
        "CircuitBreakerBreakSeconds": 20,
        "CircuitBreakerFailureRatio": 0.5,
        "AttemptTimeoutSeconds": 3,
        "TotalTimeoutSeconds": 8
      }
    },
    "IssueTracker": {
      "BaseUrl": "https://issues.example.internal",
      "TimeoutSeconds": 5,
      "Resilience": {
        "RetryMaxAttempts": 3,
        "CircuitBreakerMinimumThroughput": 5,
        "CircuitBreakerSamplingSeconds": 30,
        "CircuitBreakerBreakSeconds": 30,
        "CircuitBreakerFailureRatio": 0.5,
        "AttemptTimeoutSeconds": 4,
        "TotalTimeoutSeconds": 10
      }
    },
    "Notification": {
      "BaseUrl": "https://notify.example.internal",
      "TimeoutSeconds": 5,
      "Resilience": {
        "RetryMaxAttempts": 2,
        "CircuitBreakerMinimumThroughput": 5,
        "CircuitBreakerSamplingSeconds": 30,
        "CircuitBreakerBreakSeconds": 20,
        "CircuitBreakerFailureRatio": 0.5,
        "AttemptTimeoutSeconds": 3,
        "TotalTimeoutSeconds": 8
      }
    }
  },
  "AllowedHosts": "*"
}
